{
  "name": "scadpub",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "ScadPub publishes OpenSCAD models as static browser-based configurators.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "gen": "node scripts/gen-schema.mjs && node scripts/gen-config-schema.mjs",
    "wasm": "node scripts/fetch-wasm.mjs",
    "predev": "npm run wasm && npm run gen",
    "dev": "vite",
    "prebuild": "npm run wasm && npm run gen",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "pretest": "npm run gen",
    "test": "node --import ./tests/register-ts.mjs --test \"tests/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "vis": "node scripts/screenshots.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "e2e:svg": "node scripts/e2e-svg-wizard.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:scad": "node scripts/check-scad-semantics.mjs",
    "check:studio": "node scripts/check-studio.mjs",
    "check:svg": "node scripts/check-svg-inert.mjs",
    "i18n:status": "node scripts/i18n-status.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.24.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
