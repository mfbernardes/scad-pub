{
  "$schema": "./scadpub.config.schema.json",
  "title": "ScadPub",
  "id": "scadpub",
  "description": "ScadPub publishes OpenSCAD models as static browser-based configurators.",
  "source": "examples",
  "designs": [
    {
      "id": "tag",
      "presets": {
        "images": {
          "Large tag": "examples/tag-preset-large.png",
          "With hole": "examples/tag-preset-hole.png"
        }
      }
    },
    {
      "id": "coin"
    },
    {
      "id": "panel"
    }
  ],
  "assets": [
    "emblem.svg",
    "panel.svg"
  ],
  "render": {
    "features": [],
    "fonts": [
      "LiberationSans-Bold.ttf",
      "LiberationSans-Regular.ttf"
    ]
  },
  "pwa": {
    "install": "off",
    "shortName": "ScadPub",
    "icon": "branding/scadpub-icon.svg",
    "iconMaskable": "branding/scadpub-icon-maskable.svg",
    "themeColor": {
      "light": "#eef1f6",
      "dark": "#14161c"
    },
    "backgroundColor": "#14161c",
    "categories": [
      "utilities",
      "productivity",
      "graphics"
    ]
  },
  "ui": {
    "gallery": true,
    "essentials": true,
    "afterExport": {
      "helpTab": "printing"
    }
  },
  "fileImport": true,
  "popup": {
    "mode": "dismissible"
  },
  "help": {
    "tabs": [
      {
        "id": "walkthrough"
      },
      {
        "id": "printing"
      },
      {
        "id": "troubleshooting"
      }
    ]
  },
  "notices": [
    {
      "marker": "alert",
      "color": "#e0a458",
      "attention": true
    },
    {
      "marker": "note",
      "color": "#86a9ff"
    }
  ],
  "text": {
    "en": "scadpub.text.en.json",
    "de": "scadpub.text.de.json"
  }
}
