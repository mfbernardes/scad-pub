{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScadPub configuration",
  "description": "scadpub.config.json. Generated from scripts/lib/config-spec.mjs by scripts/gen-config-schema.mjs — see docs/config.md for the full human reference.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Optional pointer to a JSON Schema for editor tooling; not read by gen-schema itself.",
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "description": "Browser tab title and header text.",
      "default": "ScadPub",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Namespaces localStorage, IndexedDB and the preset cache (charset [A-Za-z0-9._-]+).",
      "default": "scadpub",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "description": "Page <meta> description and PWA description.",
      "default": "Configure and export designs in your browser.",
      "type": [
        "string",
        "null"
      ]
    },
    "lang": {
      "description": "Document/manifest language, a BCP-47 tag.",
      "default": "en",
      "type": [
        "string",
        "null"
      ]
    },
    "dir": {
      "description": "Document/manifest text direction.",
      "default": "ltr",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "languages": {
      "description": "Which shipped chrome locales (see src/lib/localeRegistry.ts) this deployment's language switcher offers. Defaults to every shipped locale, 'lang' first, when 'lang' is one of them; otherwise to a single-locale deployment (the switcher stays hidden). When set, every entry must name a shipped locale and the set must include the deployment's resolved default locale.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "text": {
      "description": "Opt-in: locale tag -> config-relative text-file path, moving ALL config-authored prose (English included) into per-locale files instead of writing it inline. The default locale's file is required and must be complete; every field it covers becomes a build error if also written inline. See docs/config.md 'Localizing config text'.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "pwa": {
      "description": "Manifest-only PWA chrome (install metadata, icons, theming) that feeds manifest.webmanifest and the icon rasterizer at build time. Not mirrored into designs.json — the app itself never reads a 'pwa' object.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "shortName": {
          "description": "Short PWA name; defaults to 'title'.",
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "description": "PWA/favicon icon path, relative to the config file.",
          "type": [
            "string",
            "null"
          ]
        },
        "iconMaskable": {
          "description": "Separate SVG for the maskable icon; defaults to 'icon'.",
          "type": [
            "string",
            "null"
          ]
        },
        "themeColor": {
          "description": "Per-theme PWA/browser-chrome colour: a string for both themes, or { light, dark } (either may be omitted, defaulting independently: light '#ffffff', dark '#1f2229'). Same shape as 'logo'.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "light": {
                  "description": "Light-scheme <meta name=theme-color>. Default '#ffffff'.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dark": {
                  "description": "Dark-scheme browser-chrome / PWA colour. Default '#1f2229'.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "backgroundColor": {
          "description": "PWA manifest background colour. A CSS colour string (hex, rgb()/rgba()/hsl()/hsla(), or a named colour).",
          "default": "#15171c",
          "type": [
            "string",
            "null"
          ]
        },
        "categories": {
          "description": "Manifest categories array.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "screenshots": {
          "description": "Richer Android install-UI screenshots: [{ src, sizes, form_factor, label?, platform? }].",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object"
          }
        },
        "shortcuts": {
          "description": "App shortcuts for Android long-press / desktop jump lists: [{ name, short_name?, url, icons? }].",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object"
          }
        },
        "install": {
          "description": "PWA install affordance; 'off' hides it entirely.",
          "default": "auto",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "auto",
                "off"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "description": "Directory of Customizer-style .scad designs, relative to the config file.",
      "default": ".",
      "type": [
        "string",
        "null"
      ]
    },
    "designs": {
      "description": "Explicit design list; omit to auto-discover *.scad in 'source'.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Design id (charset [A-Za-z0-9._-]+); used in URLs, storage, filenames.",
            "type": "string"
          },
          "label": {
            "description": "Picker label; defaults to a humanized id. Localizable.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "file": {
            "description": "Path to the .scad file, relative to 'source'; defaults to '<id>.scad'.",
            "type": [
              "string",
              "null"
            ]
          },
          "heavy": {
            "description": "Start this design in manual-render mode.",
            "default": false,
            "type": [
              "boolean",
              "null"
            ]
          },
          "group": {
            "description": "Dropdown/gallery grouping header; consecutive same-value designs cluster. Localizable.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "presets": {
            "description": "This design's bundled-preset presentation.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "images": {
                "description": "Bundled-preset thumbnails: either a preset-name -> image-path map (every key must match a real bundled preset name), or a single config-relative directory string (each preset's image looked up by slugifying its name — see docs/config.md). Preset images are optional per preset either way.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "defaultDesign": {
      "description": "Design id shown on a visit with no #d= deep link; must name a configured design.",
      "type": [
        "string",
        "null"
      ]
    },
    "assets": {
      "description": "Files/directories/globs to bundle verbatim; omit to follow use/include.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "render": {
      "description": "Rendering: OpenSCAD flags/format/fonts (render inputs — folded into renderHash) plus build-time heavy-render-threshold/cache tuning ('heavyMs'/'cache' — display/perf only, absent from renderHash).",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "features": {
          "description": "OpenSCAD --enable=<feature> flags applied to every render. Folded into renderHash.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "format": {
          "description": "Export/preview model format. Folded into renderHash.",
          "default": "3mf",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "3mf",
                "stl"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fonts": {
          "description": "Bundled font files (public/fonts basenames or 'source'-relative paths). Folded into renderHash.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "fontFallback": {
          "description": "A bundled family pinned as fontconfig's last-resort default. Folded into renderHash.",
          "type": [
            "string",
            "null"
          ]
        },
        "heavyMs": {
          "description": "Auto-pause threshold (ms) for a slow live render. NOT in renderHash.",
          "type": [
            "number",
            "null"
          ]
        },
        "cache": {
          "description": "Sizes the runner's two-tier render cache.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "maxEntries": {
              "description": "In-memory (L1) slot count.",
              "type": [
                "number",
                "null"
              ]
            },
            "maxBytes": {
              "description": "In-memory (L1) total byte budget.",
              "type": [
                "number",
                "null"
              ]
            },
            "maxEntryBytes": {
              "description": "Largest single render worth caching.",
              "type": [
                "number",
                "null"
              ]
            },
            "persistent": {
              "description": "Persist renders to IndexedDB (L2).",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "logo": {
      "description": "Header logo: a path, or { light, dark } per-theme paths (config-relative).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "light": {
              "description": "Logo path used in the light theme.",
              "type": [
                "string",
                "null"
              ]
            },
            "dark": {
              "description": "Logo path used in the dark theme.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "colors": {
