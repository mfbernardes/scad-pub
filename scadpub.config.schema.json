    "extraCss": {
      "description": "Raw-CSS stylesheet path (config-relative), loaded after the app's own styles.",
      "type": [
        "string",
        "null"
      ]
    },
    "ui": {
      "description": "Build-time UI behaviour: panel/output defaults and labels.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "panelSide": {
          "description": "Which edge the desktop parameter panel docks against.",
          "default": "left",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "panelDefault": {
          "description": "First-load desktop panel state.",
          "default": "open",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "open",
                "collapsed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "outputDefault": {
          "description": "Whether the OpenSCAD output console starts open.",
          "default": "closed",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "closed",
                "open"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "showVarName": {
          "description": "Show the OpenSCAD variable name beside each parameter label.",
          "default": false,
          "type": [
            "boolean",
            "null"
          ]
        },
        "saveImage": {
          "description": "Show the 'Save image (PNG)' action.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "gallery": {
          "description": "Replace the compact design dropdown with a searchable card grid.",
          "default": false,
          "type": [
            "boolean",
            "null"
          ]
        },
        "essentials": {
          "description": "Start with // @advanced parameters hidden behind 'Show all settings'.",
          "default": false,
          "type": [
            "boolean",
            "null"
          ]
        },
        "afterExport": {
          "description": "Turns on the after-export success panel: true for defaults, or { helpTab }.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "helpTab": {
                  "description": "Opens Help scrolled to the tab with this id (help.tabs[].id, checked first) or, for back-compat, this exact label (help.tabs[].label); must name a real tab either way.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "viewer": {
      "description": "The 3D viewer's presentation, framing, and per-control visibility, fixed at build time.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "style": {
          "description": "'plain' is the classic CAD preview; 'studio' adds image-based lighting and a contact shadow.",
          "default": "plain",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "plain",
                "studio"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "restOnGrid": {
          "description": "Rest the model's base on the z=0 grid instead of centring in Z (display-only).",
          "default": false,
          "type": [
            "boolean",
            "null"
          ]
        },
        "grid": {
          "description": "Seeds the viewer's reference-grid toggle's first-ever value. The toggle itself is always offered — this is not a visibility flag, unlike 'controls' below — and a visitor's own later choice persists and wins on every subsequent visit.",
          "default": "off",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "off",
                "on"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "controls": {
          "description": "Visibility of the individual viewer HUD control buttons. None of these hide the 3D canvas itself.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "measure": {
              "description": "Show the viewer's measure (ruler) toggle.",
              "default": true,
              "type": [
                "boolean",
                "null"
              ]
            },
            "viewPicker": {
              "description": "Show the camera-angle cube button.",
              "default": true,
              "type": [
                "boolean",
                "null"
              ]
            },
            "reset": {
              "description": "Show the 'reset view' button.",
              "default": true,
              "type": [
                "boolean",
                "null"
              ]
            },
            "zoom": {
              "description": "Show explicit zoom in/out buttons.",
              "default": false,
              "type": [
                "boolean",
                "null"
              ]
            },
            "fullscreen": {
              "description": "Show the fullscreen toggle (browser tabs only).",
              "default": true,
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fileImport": {
      "description": "Enables the Files dialog. true for defaults, or an options object; omit/false/null for no Files action.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "note": {
              "description": "Markdown-subset guidance shown atop the Files dialog. Mutually exclusive with 'noteFile'. Localizable.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "noteFile": {
              "description": "Config-relative Markdown file whose contents become 'note' at build time. Mutually exclusive with 'note' (setting both fails the build, naming both).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "popup": {
      "description": "One-off notice dialog shown over the app on load.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "header": {
          "description": "Dialog title. Localizable, see docs/config.md.",
          "anyOf": [
