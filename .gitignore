# Node deps & build output
node_modules/
dist/

# Large vendored WASM binary + glue — fetched via scripts/fetch-wasm.mjs
public/wasm/

# Generated from the configured design source via scripts/gen-schema.mjs
public/scad/
# Browser-facing artwork (design icon/image/preset thumbnails, header logo):
# split out of public/scad/ so public/sw.js's stale-while-revalidate branch
# serves it cache-first instead of the network-first treatment every scad/
# path gets (it's build-volatile source content, artwork isn't).
public/art/
# gen-schema builds the new tree here and renames it over public/scad/ (resp.
# public/art/) at its commit point; a build that dies partway leaves it
# behind, and an untracked half-built tree must never be committable.
public/scad.staging/
public/art.staging/
src/generated/
# fontconfig config is generated (carries the optional fontFallback rule)
public/fonts/fonts.conf

# Render outputs
*.stl

# Visual-regression diff output (baselines live in tests/screenshots/, tracked)
/screenshots/

# TypeScript incremental build info
*.tsbuildinfo

# Generated PWA assets (from the active config via gen-schema)
public/manifest.webmanifest
public/icon.svg
public/icon-180.png
public/icon-192.png
public/icon-512.png
public/icon-512-maskable.png
public/apple-splash-*.png
public/precache-manifest.json

# Ownership manifest for generated files outside public/scad/ (fonts copied
# from source, PWA root assets) — scripts/lib/destinations.mjs uses it to
# clean up files a removed/renamed config entry left behind (M8).
/.gen-manifest.json
public/.gen-manifest.json

# Playwright artifacts (if a contributor runs `playwright test`)
/test-results/
/playwright-report/

# Local env overrides (Vite reads .env*; *.local stays out of git)
*.local
.env*.local

# Logs
*.log
npm-debug.log*

# Editor / OS cruft
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?

# Claude
.claude/settings.local.json

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
dist-studio/
# check-studio.mjs writes this at the repo root (config-relative paths must
# still resolve) and removes it in a `finally`. A kill signal skips that, and an
# uncommitted copy of the operator's config is not something a later `git add
# -A` should sweep up.
studio.check.config.json
